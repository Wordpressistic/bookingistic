<?xml version="1.0"?>
<ruleset name="Bookingistic">
	<description>WordPress Coding Standards for Bookingistic. All WordPress.DB, WordPress.Security, WordPress.WP and code-analysis sniffs are enforced in full; only pure formatting/documentation-style sniffs that the existing codebase does not follow are excluded.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="s"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress">
		<!-- Formatting / documentation style only (no security or DB impact). -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.DisallowStandalonePostIncrementDecrement"/>
		<exclude name="Universal.WhiteSpace"/>
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.Arrays"/>
		<exclude name="WordPress.WhiteSpace"/>
		<exclude name="Generic.Formatting"/>
		<exclude name="Generic.WhiteSpace"/>
		<exclude name="Generic.Functions.FunctionCallArgumentSpacing"/>
		<exclude name="Generic.Files.LineEndings"/>
		<exclude name="Generic.Commenting"/>
		<exclude name="Squiz.Commenting"/>
		<exclude name="Squiz.Strings.DoubleQuoteUsage"/>
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_bookingistic"/>
				<element value="view_bookingistic"/>
				<element value="create_bookingistic_bookings"/>
				<element value="edit_bookingistic_bookings"/>
				<element value="delete_bookingistic_bookings"/>
				<element value="manage_bookingistic_services"/>
				<element value="manage_bookingistic_staff"/>
				<element value="manage_bookingistic_settings"/>
				<element value="manage_bookingistic_email_automations"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="bookingistic"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="bookingistic"/></property>
		</properties>
	</rule>
</ruleset>
